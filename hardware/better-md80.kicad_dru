(version 1)

# 60 V nets (net class HV_60V) are routed at 0.2 mm clearance. That meets IPC-2221B B4
# (external, coated: 0.13 mm for 51-100 V) but not B2 (uncoated: 0.6 mm), so the board
# REQUIRES conformal coating over the power stage and gate-drive area.
# Around the DRV8353 / LM5164 pins the package pitch sets the spacing.
(rule "HV at fine-pitch fan-out"
	(condition "A.NetClass == 'HV_60V' && (A.intersectsArea('FINEPITCH_U4') || A.intersectsArea('FINEPITCH_U1') || A.memberOfFootprint('Q*'))")
	(constraint clearance (min 0.15mm)))
